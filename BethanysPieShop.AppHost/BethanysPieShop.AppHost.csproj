<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.0" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <!-- Aspire CLI bundle not used; DCP/Dashboard come from the AppHost SDK packages. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);ASPIRE010</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BethanysPieShopAdvanced.Admin\BethanysPieShop.Admin.csproj" />
    <ProjectReference Include="..\BethanysPieShopAdvanced.WebApi\BethanysPieShop.WebApi.csproj" />
  </ItemGroup>

</Project>
