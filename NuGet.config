<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Restrict sources to nuget.org to avoid the inaccessible Azure DevOps feed -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Optional: map sources per project if needed -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!-- Ensure credential provider doesn't block builds if private feeds are unavailable -->
  <config>
    <add key="dependencyVersion" value="Highest" />
  </config>
</configuration>