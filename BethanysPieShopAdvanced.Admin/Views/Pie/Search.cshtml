@model PieSearchViewModel

<link rel="stylesheet" href="~/css/gridStyles.css" />

<h2>Search pies</h2>
<hr />

<form asp-controller="Pie" asp-action="Search" method="get">
    <div class="mb-3">
        <label class="form-label">Category</label>
        <select asp-for="SearchCategory" asp-items="Model.Categories" class="form-control">
            <option value="">All</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Search value</label>
        <input type="text" asp-for="SearchQuery" class="form-control" />
    </div>
    <input type="submit" value="Filter" class="btn btn-primary" />
</form>

@if (Model.IsNullOrEmpty) 
{
    <p>No results</p>
}
else
{
    <div class="grid-table grid-4-columns">
        <div class="grid-header">
            <div>Id</div>
            <div>Name</div>
            <div>Price</div>
            <div>Actions</div>
        </div>

        @foreach (var pie in Model.Pies!)
        {
            <div class="grid-row">
                <div>@pie.Id</div>
                <div>@pie.Name</div>
                <div>@pie.Price</div>
                <div>
                    <a asp-controller="Pie" asp-action="Details" asp-route-id="@pie.Id">Details</a>
                    <a asp-controller="Pie" asp-action="Edit" asp-route-id="@pie.Id">Edit</a>
                    <a asp-controller="Pie" asp-action="Delete" asp-route-id="@pie.Id">Delete</a>
                </div>
            </div>
        }
    </div>
}

<div>
    <a asp-controller="Pie" asp-action="Index">Back to Pie Overview</a>
</div>
