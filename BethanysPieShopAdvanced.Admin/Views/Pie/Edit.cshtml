@model PieEditViewModel

<h2>Update the Pie: @Model.PieDto!.Name</h2>
<hr />

@if (string.IsNullOrEmpty(Model.ErrorMessage))
{
    <p class="alert alert-danger">@Model.ErrorMessage</p>
}

<form asp-controller="Pie" asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="PieDto!.Id" />
    <input type="hidden" asp-for="PieDto!.RowVersion" />

    <div class="mb-3">
        <label asp-for="PieDto!.Name" class="form-label"></label>
        <input asp-for="PieDto!.Name" class="form-control" />
        <span asp-validation-for="PieDto!.Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PieDto!.ShortDescription" class="form-label"></label>
        <textarea asp-for="PieDto!.ShortDescription" class="form-control"
                  rows="5" cols="50" style="resize: none;">
        </textarea>
        <span asp-validation-for="PieDto!.ShortDescription" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PieDto!.LongDescription" class="form-label"></label>
        <textarea asp-for="PieDto!.LongDescription" class="form-control"
                  rows="5" cols="50" style="resize: none;">
        </textarea>
        <span asp-validation-for="PieDto!.LongDescription" class="text-danger"></span>
    </div>


    <div class="mb-3">
        <label asp-for="PieDto!.AllergyInformation" class="form-label"></label>
        <textarea asp-for="PieDto!.AllergyInformation" class="form-control"
                  rows="5" cols="50" style="resize: none;">
        </textarea>
        <span asp-validation-for="PieDto!.AllergyInformation" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PieDto!.Price" class="form-label"></label>
        <input asp-for="PieDto!.Price" class="form-control" />
        <span asp-validation-for="PieDto!.Price" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PieDto!.ImageThumbnailUrl" class="form-label"></label>
        <input asp-for="PieDto!.ImageThumbnailUrl" class="form-control" />
        <span asp-validation-for="PieDto!.ImageThumbnailUrl" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PieDto!.ImageUrl" class="form-label"></label>
        <input asp-for="PieDto!.ImageUrl" class="form-control" />
        <span asp-validation-for="PieDto!.ImageUrl" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PieDto!.IsPieOfTheWeek" class="form-label"></label>
        <input asp-for="PieDto!.IsPieOfTheWeek" type="checkbox" />
        <span asp-validation-for="PieDto!.IsPieOfTheWeek" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PieDto!.InStock" class="form-label"></label>
        <input asp-for="PieDto!.InStock" type="checkbox" />
        <span asp-validation-for="PieDto!.InStock" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Categories" class="form-label"></label>
        <select asp-for="PieDto!.CategoryId" asp-items="Model.Categories">
            <option value="">Select a Category</option>
        </select>
        <span asp-validation-for="PieDto!.CategoryId" class="text-danger"></span>
    </div>

    <input type="submit" value="Update the Pie" class="btn btn-primary" />
</form>

<br />
<div>
    <a asp-controller="Pie" asp-action="Index">Back to Pie Overview</a>
</div>
