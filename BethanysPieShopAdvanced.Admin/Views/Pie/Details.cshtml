@model PieDetailsViewModel

<h2>Details for the Pie: @Model.PieDto?.Name</h2>
<hr />

@if (string.IsNullOrEmpty(Model.ErrorMessage) == false)
{
    <p class="alert alert-danger">@Model.ErrorMessage</p>
}

<div>
    <dl class="row">
        <dt class="col-sm-2">
            <label asp-for="@Model.PieDto!.Id"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.PieDto?.Id
        </dd>

        <dt class="col-sm-2">
            <label asp-for="@Model.PieDto!.Name"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.PieDto?.Name
        </dd>

        <dt class="col-sm-2">
            <label asp-for="@Model.PieDto!.ShortDescription"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.PieDto?.ShortDescription
        </dd>

        <dt class="col-sm-2">
            <label asp-for="@Model.PieDto!.LongDescription"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.PieDto?.LongDescription
        </dd>

        <dt class="col-sm-2">
            <label asp-for="@Model.PieDto!.Price"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.PieDto?.Price
        </dd>

        <dt class="col-sm-2">
            <label asp-for="@Model.PieDto!.AllergyInformation"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.PieDto?.AllergyInformation
        </dd>

        <dt class="col-sm-2">
            <label asp-for="@Model.PieDto!.IsPieOfTheWeek"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.PieDto?.IsPieOfTheWeek
        </dd>

        <dt class="col-sm-2">
            <label asp-for="@Model.PieDto!.InStock"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.PieDto?.InStock
        </dd>

        <dt class="col-sm-2">
            <label asp-for="@Model.PieDto!.CategoryId"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.PieDto?.CategoryId
        </dd>

        <dt class="col-sm-2">
            <label asp-for="@Model.PieDto!.CategoryName"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.PieDto?.CategoryName
        </dd>
    </dl>
</div>

<br />
<div>
    <a asp-controller="Pie" asp-action="Index">Back to Pie Overview</a>
</div>