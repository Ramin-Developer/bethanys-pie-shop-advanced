@model PieDeleteViewModel

<h2>Delete the Pie: @Model.PieDto?.Name</h2>
<hr />

@if (string.IsNullOrEmpty(Model.ErrorMessage) == false)
{
    <p class="alert alert-danger">@Model.ErrorMessage</p>
}

<div>
    <dl class="row">
        <dt class="col-sm-2">
            <label asp-for="@Model.PieDto!.Id"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.PieDto?.Id
        </dd>
        <dt class="col-sm-2">
            <label asp-for="@Model.PieDto!.Name"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.PieDto?.Name
        </dd>
        <dt class="col-sm-2">
            <label asp-for="@Model.PieDto!.ShortDescription"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.PieDto?.LongDescription
        </dd>
    </dl>
</div>

<form asp-controller="Pie" asp-action="DeleteConfirmed" asp-route-id="@Model.PieDto!.Id" method="post">
    <input type="hidden" asp-for="PieDto!.Id" />
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
</form>

<br />
<div>
    <a asp-controller="Pie" asp-action="Index">Back to Pie Overview</a>
</div>
