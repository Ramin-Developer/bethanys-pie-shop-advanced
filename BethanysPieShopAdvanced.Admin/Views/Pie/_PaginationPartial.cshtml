@model PaginatedPieViewModel

<div>
    <a asp-controller="Pie" asp-action="IndexPagingSorting"
       asp-route-pageNumber="@Model.FirstPage"
       asp-route-sortOption="@Model.CurrentSort"
       class="btn btn-default @Model.FirstBtnEnabled">First</a>

    <a asp-controller="Pie" asp-action="IndexPagingSorting"
       asp-route-pageNumber="@Model.PreviousPage"
       asp-route-sortOption="@Model.CurrentSort"
       class="btn btn-default @Model.PreviousBtnEnabled">Previous</a>

    <a asp-controller="Pie" asp-action="IndexPagingSorting"
       asp-route-pageNumber="@Model.NextPage"
       asp-route-sortOption="@Model.CurrentSort"
       class="btn btn-default @Model.NextBtnEnabled">Next</a>

    <a asp-controller="Pie" asp-action="IndexPagingSorting"
       asp-route-pageNumber="@Model.LastPage"
       asp-route-sortOption="@Model.CurrentSort"
       class="btn btn-default @Model.LastBtnEnabled">Last</a>
</div>
