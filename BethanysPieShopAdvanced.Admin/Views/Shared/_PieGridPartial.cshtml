@model PaginatedPieViewModel

@foreach (var pie in Model.Pies)
{
    <div class="grid-row">
        <div>@pie.Id</div>
        <div>@pie.Name</div>
        <div>@pie.CategoryId</div>
        <div>@pie.CategoryName</div>
        <div>@pie.Price</div>

        @* Action Links to: Details, Edit, Delete *@
        @await <partial name="_PieActionPartial" model="pie" />
    </div>
}
