@model CategoryDto

<h2>Update the Category: @Model.Name</h2>
<hr />

<form asp-controller="Category" asp-action="Update" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="@Model.Id" />
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="5" cols="50" style="resize: none;"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DateAdded" class="form-label"></label>
        <input asp-for="DateAdded" class="form-control" />
        <span asp-validation-for="DateAdded" class="text-danger"></span>
    </div>

    <input type="submit" value="Update Category" class="btn btn-primary" />
</form>

<br />
<div>
    <a asp-controller="Category" asp-action="Index">Back to Category Overview</a>
</div>
