@model CategoryDto

<h2>Details for the Category: @Model.Name</h2>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">
            <label asp-for="Id"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.Id
        </dd>

        <dt class="col-sm-2">
            <label asp-for="Name"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.Name
        </dd>

        <dt class="col-sm-2">
            <label asp-for="Description"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.Description
        </dd>

        <dt class="col-sm-2">
            <label asp-for="DateAdded"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.DateAdded.ToShortDateString()
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PieList)
        </dt>
        <dd class="col-sm-10">
            <table class="table table-striped table-bordered">
                <tr>
                    <th>Pie name</th>
                    <th>Price</th>
                </tr>
                @foreach (var pie in Model.PieList)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(category => pie.Name)
                        </td>
                        <td>
                            @Html.DisplayFor(category => pie.Price)
                        </td>
                    </tr>
                }
            </table>
        </dd>
    </dl>
</div>

<br />
<div>
    <a asp-controller="Category" asp-action="Index">Back to Category Overview</a>
</div>
