@model OrderIndexViewModel

<h2>Orders</h2>
<hr />

<table class="table table-striped table-bordered">
    <tr>
        <th>First Name</th>
        <th>Last Name</th>
        <th>Total Price</th>
        <th>Actions</th>
    </tr>
    @foreach (var order in Model.OrderDtoList)
    {
        var selectedRow = string.Empty;
        if (order.Id == Model.SelectedOrderId)
        {
            selectedRow = "success";
        }

        <tr class="@selectedRow">
            <td>
                @Html.DisplayFor(m => order.FirstName)
            </td>
            <td>
                @Html.DisplayFor(m => order.LastName)
            </td>
            <td>
                @Html.DisplayFor(m => order.OrderTotal)
            </td>
            <td>
                <a asp-action="Index" asp-route-orderId="@order.Id">Select</a>
                <a asp-action="Details" asp-route-orderId="@order.Id">Details</a>
            </td>
        </tr>
    }
</table>

@if (Model.OrderLines != null)
{
    <h3>Order details for the selected order</h3>
    <table class="table table-striped table-bordered">
        <tr>
            <th>Order Line ID</th>
            <th>Amount</th>
            <th>Price</th>
            <th>Actions</th>
        </tr>

        @foreach (var orderline in Model.OrderLines)
        {
            string selectedRow = "";
            if (orderline.Id == Model.SelectedOrderLineId)
            {
                selectedRow = "success";
            }
            <tr class="@selectedRow">
                <td>
                    @orderline.Id
                </td>
                <td>
                    @orderline.Amount
                </td>
                <td>
                    @orderline.Price
                </td>
                <td>
                    <a asp-action="Index" asp-route-orderId="@orderline.OrderId"
                       asp-route-orderLineId="@orderline.Id">Pie Details</a>
                </td>
            </tr>
        }
    </table>
}

@if (Model.Pies != null)
{
    <h3>Pie in the order details</h3>
    <table class="table table-condensed table-bordered">
        <tr>
            <th>Name</th>
            <th>Item price</th>
        </tr>
        @foreach (var item in Model.Pies)
        {
            <tr>
                <td>
                    @item.Name
                </td>
                <td>
                    @item.Price
                </td>
            </tr>
        }
    </table>
}
